# Copy to .env (or set these in your shell) before any real deployment.
# Secret used to sign login tokens. Use a long random string. If missing, a built-in development secret is used.
JWT_SECRET=change-me-to-a-long-random-string
# Port of the API (the frontend expects 3000)
PORT=3000
# Optional: folder where saved data (JSON files) lives. Default: ./data/db
# DATA_DIR=./data/db
# Business time zone for dates (expense dates, due dates, "today"). Default: Asia/Kolkata
# APP_TIMEZONE=Asia/Kolkata
